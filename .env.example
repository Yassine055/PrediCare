# ─────────────────────────────────────────────────────────────────────────────
# PrediCare — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais commiter le fichier .env dans le dépôt Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ───────────────────────────────────────────────────────────
# PostgreSQL (production) :
#   postgresql://utilisateur:motdepasse@hote:5432/nom_base
# SQLite (développement local, valeur par défaut si absent) :
#   sqlite:///./predicare.db
DATABASE_URL=postgresql://predicare_user:motdepasse_securise@localhost:5432/predicare_db

# ── Sécurité JWT ──────────────────────────────────────────────────────────────
# Générer une clé aléatoire forte :  openssl rand -hex 32
SECRET_KEY=remplacer_par_une_cle_secrete_aleatoire_de_32_caracteres_minimum

# Algorithme de signature des tokens JWT (HS256 recommandé)
ALGORITHM=HS256

# Durée de validité du token d'accès (en minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
